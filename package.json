{
  "name": "lameddb",
  "version": "0.0.0",
  "description": "Cloud-native adaptive database with a TypeScript SDK and HTTP API.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run && node --test scripts/readiness.test.mjs",
    "mcp": "tsx src/mcp/main.ts",
    "start:mcp": "node dist/mcp/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "lameddb-mcp": "./dist/mcp/main.js"
  }
}
